# Copy to .env (gitignored) and fill in only what you use. Never commit .env.

# Hosted generators for `indicrag ask --api ...` and `indicrag serve --api ...`.
# Questions and retrieved passages are sent to the provider you choose.
GROQ_API_KEY=
GEMINI_API_KEY=

# Where corpus, indices and caches live (see scripts/dev-env.ps1).
# INDICRAG_DATA_DIR=G:\indicrag-data\corpus

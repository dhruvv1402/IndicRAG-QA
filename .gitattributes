# Development happens on Windows; CI and any Linux checkout must see the same bytes.
# Shell scripts with CRLF fail with "bad interpreter", so pin them to LF explicitly.
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
Dockerfile  text eol=lf
.gitignore  text eol=lf

# PowerShell is the Windows-side twin; CRLF is correct there.
*.ps1       text eol=crlf

# JSONL corpora and gold sets hold Devanagari. Mark them as text so diffs are
# readable, but never let git touch the line endings inside a record.
*.jsonl     text eol=lf working-tree-encoding=UTF-8
*.json      text eol=lf
*.md        text eol=lf

# Binary artefacts: never diff, never convert.
*.npy       binary
*.pkl       binary
*.gguf      binary
*.pdf       binary
*.docx      binary
*.pptx      binary
